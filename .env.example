# Production deployment template. Replace every placeholder before starting Compose.
APP_ENVIRONMENT=production
POSTGRES_DB=snoc_langgraph
POSTGRES_USER=snoc_langgraph
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://snoc_langgraph:replace_with_a_long_random_password@postgres:5432/snoc_langgraph
# Safe default keeps the original imperative processor. Set to langgraph only
# after running the parity suite in the target environment.
WORKFLOW_ENGINE=langgraph
SNOC_COMPOSE_PROJECT_NAME=snoc-langgraph
SNOC_API_BIND_ADDRESS=0.0.0.0
SNOC_API_PORT=8000
SNOC_DASHBOARD_PORT=8502
SNOC_POSTGRES_VOLUME=snoc_langgraph_postgres_data

# The bootstrap admin cannot be edited in the dashboard. Use unique random secrets.
DASHBOARD_ADMIN_USERNAME=snoc-admin
DASHBOARD_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
AUTH_JWT_SECRET=replace_with_at_least_32_random_bytes
AUTH_TOKEN_TTL_MINUTES=480
CORS_ALLOWED_ORIGINS=https://dataproducts.majesteye.com
VITE_API_BASE_URL=

# IMAP: use UNSEEN for ordinary Gmail/manual testing.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=replace-with-agent-mailbox@example.com
IMAP_PASSWORD=replace_with_imap_application_password
IMAP_MAILBOX=INBOX
IMAP_SSL=true
IMAP_POLL_SECONDS=30
# Deliberately avoid ALL on first deployment, which could process historical mail.
# Review unread backlog before go-live; UID/database idempotency still prevents repeat execution.
IMAP_SEARCH_CRITERION=UNSEEN

# SMTP
SMTP_HOST=replace-with-smtp-host.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-agent-mailbox@example.com
SMTP_PASSWORD=replace_with_smtp_application_password
SMTP_FROM_ADDRESS=replace-with-agent-mailbox@example.com
# Optional inbound self-message identity; defaults to SMTP_FROM_ADDRESS.
SYSTEM_EMAIL_ADDRESS=
SMTP_SSL=true
SMTP_STARTTLS=false

# Authorization / escalation
AUTHORIZED_SENDERS=replace-with-approved-sender@example.com
ESCALATION_RECIPIENT=replace-with-human-support@example.com
# Optional credentials used only by scripts/docker_mail_journey.py to act as
# an external human. The username falls back to the sole authorized sender.
SENDER_USERNAME=
SENDER_PASSWORD=
SENDER_IMAP_MAILBOX=[Gmail]/All Mail

# Production uses only the configured vLLM deployments.
LLM_PROVIDER=vllm
# Optional per-role overrides; empty values inherit LLM_PROVIDER.
# ANALYZER_PROVIDER=vllm
# VERIFIER_PROVIDER=vllm

# Primary Qwen, Gemma, and Qwen3 30B vLLM deployments. The key is shared by the three configured
# servers, remains environment-only, and is never written to model audit rows.
VLLM_API_KEY=replace_me
VLLM_QWEN_BASE_URL=http://127.0.0.1:8001/v1
VLLM_QWEN_MODEL=stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ
VLLM_GEMMA_BASE_URL=http://127.0.0.1:8003/v1
VLLM_GEMMA_MODEL=google/gemma-4-12B-it
VLLM_ANALYZER_DEPLOYMENT=gemma
VLLM_VERIFIER_DEPLOYMENT=qwen
VLLM_QWEN3_30B_BASE_URL=https://qwen3-30b.example.com/v1
VLLM_QWEN3_30B_MODEL=stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ
VLLM_REQUEST_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=2
VLLM_RETRY_BASE_SECONDS=2
VLLM_USE_JSON_SCHEMA=true
VLLM_ALLOW_JSON_OBJECT_FALLBACK=true
VLLM_ALLOW_PROMPT_JSON_FALLBACK=true
VLLM_MAX_OUTPUT_TOKENS_ANALYZER=4096
VLLM_MAX_OUTPUT_TOKENS_VERIFIER=4096
# Must match the deployments' actual context windows. The runtime reserves a
# safety margin and reduces output capacity before rejecting oversized input.
VLLM_CONTEXT_WINDOW_TOKENS_ANALYZER=8192
VLLM_CONTEXT_WINDOW_TOKENS_VERIFIER=8192
MODEL_CONTEXT_SAFETY_MARGIN_TOKENS=128

ANALYZER_TEMPERATURE=0.0
VERIFIER_TEMPERATURE=0.0
# Optional raw self-report gates; set only from an offline calibration decision.
# ANALYZER_MIN_RAW_CONFIDENCE=0.85
# VERIFIER_MIN_RAW_CONFIDENCE=0.85
QWEN3_ENABLE_THINKING=false
QWEN3_SEND_THINKING_PARAMETER=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_SUPPORTS_LOGPROBS=false
LLM_JSON_SCHEMA_MODE=true
MODEL_QUANTIZATION=

EVALUATION_RUN_BUDGET_USD=20
EVALUATION_STOP_BEFORE_BUDGET_USD=19
EVALUATION_REQUIRE_BUDGET_CONFIRMATION=false
# Unknown-cost vLLM calls continue with warnings; local USD caps cannot guarantee them.
EVALUATION_ALLOW_UNKNOWN_COST=true
EVALUATION_CHECKPOINT_EVERY=10

# Business API. Live execution is deliberately disabled by default.
BUSINESS_API_BASE_URL=https://replace-with-business-api.example.com
BUSINESS_API_TOKEN=replace_with_business_api_token
DRY_RUN=false
# Opt in only for controlled mailbox tests: telecom actions stay mocked, while
# clarification/completion/escalation messages may be delivered through SMTP.
DRY_RUN_SEND_EMAILS=false
BUSINESS_API_TIMEOUT_SECONDS=15
BUSINESS_API_MAX_RETRIES=2
BUSINESS_API_IDEMPOTENCY_GUARANTEED=false
BUSINESS_API_VPN_PATH=/create-account
BUSINESS_API_OTP_PATH=/update-otp/{pdv_code}/{new_phone}
BUSINESS_API_UNBLOCK_PATH=/unlock-account/{pdv_code}
BUSINESS_API_RESET_PATH=/reset-password/{pdv_code}
BUSINESS_API_VPN_ALLOWED_ADDITIONAL_FIELDS=

# Validation / workflow
PDV_PATTERN=^\d{8}$
PHONE_PATTERN=^\+?\d{9,15}$
MAX_CLARIFICATION_ROUNDS=1
# Conservative execution and evidence-policy defaults. Changes are audited and
# never bypass authorization, identifier validation, ambiguity, or idempotency.
EXECUTION_CORRECTION_GRACE_SECONDS=30
ALLOW_SUBJECT_BODY_CONFLICT_AUTO_EXECUTION=false
ALLOW_FORWARDED_CONTENT_AUTO_EXECUTION=false
ALLOW_UNTRUSTED_WORKFLOW_MARKER_AUTO_EXECUTION=false
ENFORCE_EVIDENCE_PROVENANCE=true
STORE_RAW_EML=true
RAW_EML_DIRECTORY=/app/var/raw_eml
LOG_EMAIL_CONTENT=false
MAX_RAW_EMAIL_BYTES=10485760
MAX_TEXT_PART_BYTES=1048576
MAX_HTML_PART_BYTES=2097152
MAX_ATTACHMENT_COUNT=20
MAX_ATTACHMENT_BYTES=5242880
MAX_MODEL_CONTEXT_CHARACTERS=24000
MAX_LATEST_MESSAGE_CHARACTERS=12000
MAX_RELEVANT_THREAD_CHARACTERS=4000
